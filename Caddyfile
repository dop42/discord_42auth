# TLS certificates are obtained and renewed automatically for $DOMAIN.
# No `log` directive: Caddy writes no access log, so no visitor IP address is kept.
{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy bot:3000
}
