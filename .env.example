# --- Discord (https://discord.com/developers/applications) ---
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# OAuth2 -> Client Secret. Used by the dashboard login.
DISCORD_CLIENT_SECRET=

# --- 42 API (https://profile.intra.42.fr/oauth/applications) ---
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# --- Random secrets, 32 characters minimum: openssl rand -hex 32 ---
STATE_SECRET=
POSTGRES_PASSWORD=
# Encrypts the database backups written by scripts/backup.sh.
BACKUP_PASSPHRASE=

# Set by compose.yaml inside Docker. Only needed for `npm run dev` outside it.
# DATABASE_URL=postgres://discord_42auth:<POSTGRES_PASSWORD>@localhost:5432/discord_42auth

# --- Where the instance is reached ---
# Public URL, without trailing slash. Must be HTTPS outside local development.
PUBLIC_URL=https://42auth.example.org
# Hostname Caddy gets a certificate for, with `docker compose --profile caddy`.
DOMAIN=42auth.example.org
# Port published on 127.0.0.1 for a reverse proxy.
PORT=3000

# --- Shown on /privacy and /terms: who runs this instance (GDPR art. 13) ---
OPERATOR_NAME=
# An email address or a URL where data-protection requests are answered.
OPERATOR_CONTACT=
# Where the data lives, e.g. "France (self-hosted)".
HOSTING_LOCATION=
