# --- Discord (https://discord.com/developers/applications) ---
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# The one Discord server this deployment serves.
# Right-click the server icon with Developer Mode on -> Copy Server ID.
GUILD_ID=

# --- 42 API (https://profile.intra.42.fr/oauth/applications) ---
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# --- Random secret signing the verification links, 32 characters minimum ---
# openssl rand -hex 32
STATE_SECRET=

# Public URL of the deployment, without trailing slash.
# Optional on Vercel: falls back to the production domain.
PUBLIC_URL=https://my-bot.vercel.app

# --- What the bot does. One deployment serves one Discord server. ---

# Role granted to verified members. Required — without it /auth is disabled.
ROLE_ID=

# Restrict to one campus, spelled as on the intra. Leave empty to accept any.
FT_CAMPUS=

# Refuse alumni. Anything but "false" keeps the check on.
# Closed accounts are refused regardless of this.
STUDENTS_ONLY=true

# How verified members are renamed: off | login | full
NICKNAME_MODE=login

# Channel logging who authenticated as whom. Leave empty to disable.
LOG_CHANNEL_ID=
